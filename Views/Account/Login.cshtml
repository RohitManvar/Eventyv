@model EventBriteClone.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Eventyv</title>
    <link href="https://fonts.googleapis.com/css2?family=Neue+Plak:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Neue Plak', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #f8f7fa;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .background-image {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            filter: brightness(0.7);
        }

        .login-container {
            position: relative;
            z-index: 1;
            background: white;
            border-radius: 8px;
            padding: 48px;
            max-width: 480px;
            width: 100%;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
        }

        .logo {
            width: 140px;
            margin-bottom: 32px;
        }

        h1 {
            font-size: 32px;
            font-weight: 700;
            color: #1e0a3c;
            margin-bottom: 8px;
        }

        h2 {
            font-size: 24px;
            font-weight: 600;
            color: #1e0a3c;
            margin-bottom: 32px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #39364f;
            margin-bottom: 8px;
        }

        input[type="email"],
        input[type="password"] {
            width: 100%;
            padding: 14px 16px;
            font-size: 16px;
            border: 2px solid #d1d5db;
            border-radius: 6px;
            transition: all 0.2s;
            font-family: inherit;
        }

            input[type="email"]:focus,
            input[type="password"]:focus {
                outline: none;
                border-color: #f05537;
            }

        .btn-primary {
            width: 100%;
            padding: 14px;
            background: #f05537;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            font-family: inherit;
        }

            .btn-primary:hover {
                background: #d63c1f;
            }

        .divider {
            text-align: center;
            margin: 32px 0;
            position: relative;
        }

            .divider::before {
                content: '';
                position: absolute;
                left: 0;
                top: 50%;
                width: 100%;
                height: 1px;
                background: #e5e7eb;
            }

            .divider span {
                background: white;
                padding: 0 16px;
                position: relative;
                color: #6b7280;
                font-size: 14px;
            }

        .social-buttons {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 24px;
        }

        .social-btn {
            padding: 12px;
            border: 2px solid #d1d5db;
            border-radius: 6px;
            background: white;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .social-btn:hover {
                border-color: #9ca3af;
                background: #f9fafb;
            }

            .social-btn img {
                width: 24px;
                height: 24px;
            }

        .terms {
            font-size: 12px;
            color: #6b7280;
            text-align: center;
            margin-top: 24px;
            line-height: 1.5;
        }

            .terms a {
                color: #3b82f6;
                text-decoration: none;
            }

                .terms a:hover {
                    text-decoration: underline;
                }

        .help-link {
            text-align: center;
            margin-top: 24px;
        }

            .help-link a {
                color: #3b82f6;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
            }

                .help-link a:hover {
                    text-decoration: underline;
                }

        .validation-summary {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <svg class="logo" viewBox="0 0 205 40" fill="#f05537">
            <path d="M24.9 11.8c-5.5 0-10 4.5-10 10s4.5 10 10 10 10-4.5 10-10-4.5-10-10-10zm0 16c-3.3 0-6-2.7-6-6s2.7-6 6-6 6 2.7 6 6-2.7 6-6 6z" />
            <text x="45" y="28" font-size="24" font-weight="600" fill="#1e0a3c">eventyv</text>
        </svg>

        <h1>Welcome!</h1>
        <h2>What's your email?</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">
                <ul style="margin: 0; padding-left: 20px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label for="email">Email</label>
                <input asp-for="Email" type="email" id="email" placeholder="Email" required />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input asp-for="Password" type="password" id="password" placeholder="Password" required />
            </div>

            <button type="submit" class="btn-primary">Continue</button>

            <div class="divider">
                <span>Or sign in with</span>
            </div>

            <div class="social-buttons">
                <button type="button" class="social-btn" onclick="alert('Apple login not implemented')">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
                    </svg>
                </button>
                <button type="button" class="social-btn" onclick="alert('Google login not implemented')">
                    <svg width="24" height="24" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                    </svg>
                </button>
                <button type="button" class="social-btn" onclick="alert('Facebook login not implemented')">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="#1877F2">
                        <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                    </svg>
                </button>
            </div>

            <div class="terms">
                By clicking Continue or the Apple, Google, or Facebook icons, you agree to Eventyv's
                <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
            </div>

            <div class="help-link">
                <a href="#">Need help finding your tickets?</a>
            </div>
        </form>
    </div>
</body>
</html>