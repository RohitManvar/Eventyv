@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    // Get session info
    var userId = HttpContextAccessor.HttpContext.Session.GetInt32("UserId");
    var userEmail = HttpContextAccessor.HttpContext.Session.GetString("UserEmail");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventBriteClone</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Neue+Plak:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* GLOBAL STYLES */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Neue Plak', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: #f8f7fa;
            color: #1e0a3c;
        }

        /* HEADER */
        header {
            background: white;
            border-bottom: 1px solid #e8e8e8;
            padding: 16px 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #f05537;
            text-decoration: none;
        }

        .search-bar {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            padding: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        }

        .search-input, .location-input {
            padding: 12px 16px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
        }

        .search-input {
            flex: 2;
        }

        .location-input {
            flex: 1;
        }

        .search-btn {
            padding: 12px 24px;
            background: #f05537;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
        }

        .nav-links {
            display: flex;
            gap: 24px;
            align-items: center;
            list-style: none;
            margin-left: 24px;
        }

            .nav-links li a {
                text-decoration: none;
                color: #39364f;
                font-weight: 500;
                font-size: 14px;
            }

                .nav-links li a:hover {
                    color: #f05537;
                }

        .dropdown-menu button {
            background: none;
            border: none;
            width: 100%;
            text-align: left;
            padding: 0.25rem 1rem;
        }

        /* FOOTER */
        footer {
            background: #1e0a3c;
            color: white;
            padding: 48px 24px 24px;
            margin-top: 64px;
        }

        .footer-content {
            max-width: 1280px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px,1fr));
            gap: 32px;
            margin-bottom: 32px;
        }

        .footer-section h3 {
            margin-bottom: 16px;
            font-size: 16px;
        }

        .footer-section a {
            display: block;
            color: #d1d5db;
            text-decoration: none;
            margin-bottom: 8px;
            font-size: 14px;
        }

            .footer-section a:hover {
                color: white;
            }

        .footer-bottom {
            max-width: 1280px;
            margin: 0 auto;
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,0.1);
            text-align: center;
            font-size: 14px;
            color: #9ca3af;
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header>
        <div class="header-container">
            <a href="/" class="logo">eventbrite</a>

            <form class="search-bar" method="get" action="/">
                <input type="text" name="search" class="search-input" placeholder="Search events" value="@ViewBag.SearchQuery" />
                <input type="text" name="location" class="location-input" placeholder="Vadodara" value="@ViewBag.Location" />
                <button type="submit" class="search-btn">
                    <i class="fas fa-search"></i>
                </button>
            </form>

            <ul class="nav-links">
                <li><a href="/Events/FindEvent">Find Events</a></li>
                <li><a href="/Events/Create">Create Events</a></li>
                <li><a href="#">Help Center</a></li>

                @if (userId.HasValue)
                {
                    <!-- User logged in -->
                    <li class="dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            @userEmail
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
<li>@Html.ActionLink("Browse Events", "FindEvent", "Events", null, new { @class = "dropdown-item" })</li>

                            <li>@Html.ActionLink("Manage My Events", "MyEvents", "Events", null, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Tickets", "MyTickets", "Account", null, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Liked", "LikedEvents", "Account", null, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Interest", "InterestedEvents", "Account", null, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Account Settings", "Settings", "Account", null, new { @class = "dropdown-item" })</li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>@Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "dropdown-item" })</li>
                        </ul>

                    </li>
                }
                else
                {
                    <!-- User not logged in -->
                    <li><a href="/Account/Login">Log In</a></li>
                    <li><a href="/Account/Register" style="color:#f05537;">Sign Up</a></li>
                }
            </ul>
        </div>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>Use Eventbrite</h3>
                <a href="#">How It Works</a>
                <a href="#">Pricing</a>
                <a href="#">Community</a>
                <a href="#">Terms</a>
            </div>

            <div class="footer-section">
                <h3>Plan Events</h3>
                <a href="#">Create Events</a>
                <a href="#">Sell Tickets</a>
                <a href="#">Event Planning</a>
                <a href="#">Event Marketing</a>
            </div>

            <div class="footer-section">
                <h3>Connect With Us</h3>
                <a href="#">Contact Support</a>
                <a href="#">About</a>
                <a href="#">Blog</a>
                <a href="#">Careers</a>
            </div>
        </div>

        <div class="footer-bottom">
            © 2025 Eventbrite Clone. Built with .NET Core MVC
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
