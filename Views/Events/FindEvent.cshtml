<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find Events</title>
    <link href="https://fonts.googleapis.com/css2?family=Neue+Plak:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Neue Plak', sans-serif;
            background: #f8f7fa;
        }

        .header {
            background: white;
            border-bottom: 1px solid #e5e7eb;
            padding: 16px 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-content {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #f05537;
            text-decoration: none;
        }

        .header-nav {
            display: flex;
            gap: 32px;
            align-items: center;
        }

            .header-nav a {
                color: #1e0a3c;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: color 0.2s;
            }

                .header-nav a:hover {
                    color: #f05537;
                }

        .btn {
            padding: 10px 24px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            font-size: 14px;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: #3b5998;
            color: white;
        }

            .btn-primary:hover {
                background: #2d4373;
            }

        .search-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 60px 24px;
            text-align: center;
        }

            .search-hero h1 {
                font-size: 48px;
                margin-bottom: 16px;
                font-weight: 700;
            }

            .search-hero p {
                font-size: 18px;
                margin-bottom: 32px;
                opacity: 0.95;
            }

        .search-bar {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            padding: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        }

            .search-bar input {
                flex: 1;
                border: none;
                padding: 12px 16px;
                font-size: 16px;
                outline: none;
                font-family: inherit;
            }

            .search-bar button {
                background: #f05537;
                color: white;
                border: none;
                padding: 12px 24px;
                border-radius: 6px;
                cursor: pointer;
                font-weight: 600;
                transition: background 0.2s;
            }

                .search-bar button:hover {
                    background: #e04429;
                }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 48px 24px;
        }

        .layout {
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 32px;
        }

        .sidebar {
            background: white;
            padding: 24px;
            border-radius: 12px;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .filter-section {
            margin-bottom: 32px;
        }

            .filter-section:last-child {
                margin-bottom: 0;
            }

            .filter-section h3 {
                font-size: 16px;
                margin-bottom: 16px;
                color: #1e0a3c;
                font-weight: 600;
            }

        .filter-option {
            display: flex;
            align-items: center;
            padding: 10px 0;
            cursor: pointer;
        }

            .filter-option input {
                width: 18px;
                height: 18px;
                margin-right: 12px;
                cursor: pointer;
            }

            .filter-option label {
                flex: 1;
                cursor: pointer;
                font-size: 14px;
                color: #6b7280;
            }

            .filter-option input:checked + label {
                color: #1e0a3c;
                font-weight: 600;
            }

        .clear-filters {
            color: #f05537;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            background: none;
            border: none;
            padding: 0;
            margin-bottom: 16px;
        }

        .date-input {
            width: 100%;
            padding: 10px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 14px;
            margin-top: 8px;
        }

        .content {
            background: white;
            border-radius: 12px;
            padding: 24px;
        }

        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid #e5e7eb;
        }

        .results-count {
            font-size: 18px;
            font-weight: 600;
            color: #1e0a3c;
        }

        .sort-dropdown {
            padding: 8px 16px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 14px;
            cursor: pointer;
            background: white;
        }

        .events-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
        }

        .event-card {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s;
            cursor: pointer;
            background: white;
        }

            .event-card:hover {
                box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
                transform: translateY(-4px);
            }

        .event-card-image {
            width: 100%;
            height: 180px;
            background-size: cover;
            background-position: center;
            position: relative;
        }

        .event-card-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: #10b981;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
        }

        .event-card-content {
            padding: 20px;
        }

        .event-card-date {
            font-size: 13px;
            color: #f05537;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .event-card-title {
            font-size: 16px;
            font-weight: 700;
            color: #1e0a3c;
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .event-card-organizer {
            font-size: 13px;
            color: #6b7280;
            margin-bottom: 12px;
        }

        .event-card-location {
            font-size: 13px;
            color: #6b7280;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 12px;
        }

        .event-card-price {
            font-size: 16px;
            font-weight: 700;
            color: #1e0a3c;
        }

        .no-results {
            text-align: center;
            padding: 60px 24px;
            color: #6b7280;
        }

            .no-results i {
                font-size: 64px;
                margin-bottom: 16px;
                opacity: 0.3;
            }

        .loading {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 24px;
            color: #6b7280;
        }

        .spinner {
            border: 4px solid #f3f4f6;
            border-top: 4px solid #3b5998;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 32px;
            padding-top: 32px;
            border-top: 1px solid #e5e7eb;
        }

        .page-btn {
            padding: 8px 16px;
            border: 1px solid #d1d5db;
            background: white;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 500;
            transition: all 0.2s;
        }

            .page-btn:hover {
                border-color: #f05537;
                color: #f05537;
            }

            .page-btn.active {
                background: #f05537;
                color: white;
                border-color: #f05537;
            }

        @@media (max-width: 968px) {
            .layout

        {
            grid-template-columns: 1fr;
        }

        .sidebar {
            position: static;
        }

        .events-grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        }

        .search-hero h1 {
            font-size: 32px;
        }

        }
    </style>
</head>
<body>
    
    <!-- Search Hero -->
    <div class="search-hero">
        <h1>Find Events</h1>
        <p>Discover amazing events happening near you</p>
        <div class="search-bar">
            <i class="fas fa-search" style="margin: 0 16px; color: #d1d5db; font-size: 18px;"></i>
            <input type="text" id="searchInput" placeholder="Search events, artists, locations...">
            <button onclick="performSearch()"><i class="fas fa-search"></i></button>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container">
        <div class="layout">
            <!-- Sidebar Filters -->
            <aside class="sidebar">
                <button class="clear-filters" onclick="clearAllFilters()">
                    <i class="fas fa-times"></i> Clear all filters
                </button>

                <div class="filter-section">
                    <h3>Category</h3>
                    <div id="categoryFilters"></div>
                </div>

                <div class="filter-section">
                    <h3>When</h3>
                    <div class="filter-option">
                        <input type="radio" name="dateFilter" id="today" value="today" onchange="applyFilters()">
                        <label for="today">Today</label>
                    </div>
                    <div class="filter-option">
                        <input type="radio" name="dateFilter" id="tomorrow" value="tomorrow" onchange="applyFilters()">
                        <label for="tomorrow">Tomorrow</label>
                    </div>
                    <div class="filter-option">
                        <input type="radio" name="dateFilter" id="thisweek" value="thisweek" onchange="applyFilters()">
                        <label for="thisweek">This Week</label>
                    </div>
                    <div class="filter-option">
                        <input type="radio" name="dateFilter" id="thismonth" value="thismonth" onchange="applyFilters()">
                        <label for="thismonth">This Month</label>
                    </div>
                </div>

                <div class="filter-section">
                    <h3>Price</h3>
                    <div class="filter-option">
                        <input type="checkbox" id="free" onchange="applyFilters()">
                        <label for="free">Free</label>
                    </div>
                    <div class="filter-option">
                        <input type="checkbox" id="paid" onchange="applyFilters()">
                        <label for="paid">Paid</label>
                    </div>
                </div>

                <div class="filter-section">
                    <h3>Location</h3>
                    <input type="text" id="locationInput" placeholder="City or address" class="date-input" style="margin-top: 0; margin-bottom: 12px;" onchange="applyFilters()">
                </div>
            </aside>

            <!-- Events Content -->
            <main class="content">
                <div class="results-header">
                    <div class="results-count">
                        <span id="resultCount">0</span> events found
                    </div>
                    <select class="sort-dropdown" onchange="sortEvents(this.value)">
                        <option value="date">Sort by date</option>
                        <option value="popular">Most popular</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                    </select>
                </div>

                <div class="loading" id="loadingContainer" style="display: none;">
                    <div class="spinner"></div>
                </div>

                <div class="events-grid" id="eventsGrid"></div>

                <div id="noResults" class="no-results" style="display: none;">
                    <i class="fas fa-calendar"></i>
                    <h3>No events found</h3>
                    <p>Try adjusting your filters or search terms</p>
                </div>

                <!-- Pagination -->
                <div class="pagination" id="paginationContainer" style="display: none;"></div>
            </main>
        </div>
    </div>

    <script>
        let allEvents = [];
        let filteredEvents = [];
        let currentPage = 1;
        let pageSize = 12;
        let selectedCategories = [];

        // Load events on page load
        window.addEventListener('DOMContentLoaded', () => {
            loadEvents();
            loadCategories();
        });

        // Load events from database
        async function loadEvents() {
            showLoading(true);
            try {
                const response = await fetch('/api/events');
                if (!response.ok) throw new Error('Failed to fetch events');

                allEvents = await response.json();
                filteredEvents = [...allEvents];
                displayEvents();
            } catch (error) {
                console.error('Error loading events:', error);
                document.getElementById('noResults').style.display = 'block';
            } finally {
                showLoading(false);
            }
        }

        // Load categories from database
        async function loadCategories() {
            try {
                const response = await fetch('/api/categories');
                if (!response.ok) throw new Error('Failed to fetch categories');

                const categories = await response.json();
                displayCategories(categories);
            } catch (error) {
                console.error('Error loading categories:', error);
            }
        }

        // Display categories in filter
        function displayCategories(categories) {
            const container = document.getElementById('categoryFilters');
            container.innerHTML = categories.map(cat => `
                <div class="filter-option">
                    <input type="checkbox" id="cat${cat.id}" value="${cat.id}" onchange="applyFilters()">
                    <label for="cat${cat.id}">${cat.name}</label>
                </div>
            `).join('');
        }

        // Display events in grid
        function displayEvents() {
            const grid = document.getElementById('eventsGrid');
            const noResults = document.getElementById('noResults');
            const pagination = document.getElementById('paginationContainer');

            // Calculate pagination
            const totalPages = Math.ceil(filteredEvents.length / pageSize);
            const startIdx = (currentPage - 1) * pageSize;
            const paginatedEvents = filteredEvents.slice(startIdx, startIdx + pageSize);

            document.getElementById('resultCount').textContent = filteredEvents.length;

            if (paginatedEvents.length === 0) {
                grid.innerHTML = '';
                noResults.style.display = 'block';
                pagination.style.display = 'none';
                return;
            }

            noResults.style.display = 'none';
            grid.innerHTML = paginatedEvents.map(event => `
                <div class="event-card" onclick="goToEventDetails(${event.id})">
                    <div class="event-card-image" style="background-image: url('${event.imageUrl || 'https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=400&h=300&fit=crop'}')">
                        <span class="event-card-badge" style="background: ${event.isFree ? '#10b981' : '#f05537'};">
                            ${event.isFree ? 'Free' : 'From $' + event.price}
                        </span>
                    </div>
                    <div class="event-card-content">
                        <div class="event-card-date">${formatDate(event.startDate)}</div>
                        <div class="event-card-title">${event.title}</div>
                        <div class="event-card-organizer">By ${event.organizer?.firstName} ${event.organizer?.lastName}</div>
                        <div class="event-card-location">
                            <i class="fas fa-map-marker-alt"></i>
                            ${event.location}
                        </div>
                        <div class="event-card-price">${event.isFree ? 'Free' : 'From $' + event.price}</div>
                    </div>
                </div>
            `).join('');

            // Display pagination
            if (totalPages > 1) {
                pagination.style.display = 'flex';
                pagination.innerHTML = '';
                for (let i = 1; i <= totalPages; i++) {
                    const btn = document.createElement('button');
                    btn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
                    btn.textContent = i;
                    btn.onclick = () => goToPage(i);
                    pagination.appendChild(btn);
                }
            } else {
                pagination.style.display = 'none';
            }
        }

        // Format date
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('en-US', {
                weekday: 'short',
                month: 'short',
                day: 'numeric',
                hour: 'numeric',
                minute: '2-digit'
            });
        }

        // Apply filters
        function applyFilters() {
            currentPage = 1;
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const location = document.getElementById('locationInput').value.toLowerCase();
            const isFreeChecked = document.getElementById('free').checked;
            const isPaidChecked = document.getElementById('paid').checked;
            const dateFilter = document.querySelector('input[name="dateFilter"]:checked')?.value;

            selectedCategories = Array.from(document.querySelectorAll('#categoryFilters input:checked')).map(cb => parseInt(cb.value));

            filteredEvents = allEvents.filter(event => {
                // Search filter
                if (searchTerm && !event.title.toLowerCase().includes(searchTerm) &&
                    !event.description.toLowerCase().includes(searchTerm)) {
                    return false;
                }

                // Location filter
                if (location && !event.location.toLowerCase().includes(location) &&
                    !event.city.toLowerCase().includes(location)) {
                    return false;
                }

                // Category filter
                if (selectedCategories.length > 0 && !selectedCategories.includes(event.categoryId)) {
                    return false;
                }

                // Price filter
                if ((isFreeChecked || isPaidChecked) &&
                    !(isFreeChecked && event.isFree) &&
                    !(isPaidChecked && !event.isFree)) {
                    return false;
                }

                // Date filter
                if (dateFilter) {
                    const eventDate = new Date(event.startDate);
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);

                    if (dateFilter === 'today') {
                        const tomorrow = new Date(today);
                        tomorrow.setDate(tomorrow.getDate() + 1);
                        if (eventDate < today || eventDate >= tomorrow) return false;
                    } else if (dateFilter === 'tomorrow') {
                        const tomorrow = new Date(today);
                        tomorrow.setDate(tomorrow.getDate() + 1);
                        const dayAfter = new Date(tomorrow);
                        dayAfter.setDate(dayAfter.getDate() + 1);
                        if (eventDate < tomorrow || eventDate >= dayAfter) return false;
                    } else if (dateFilter === 'thisweek') {
                        const weekEnd = new Date(today);
                        weekEnd.setDate(weekEnd.getDate() + 7);
                        if (eventDate < today || eventDate >= weekEnd) return false;
                    } else if (dateFilter === 'thismonth') {
                        const monthEnd = new Date(today.getFullYear(), today.getMonth() + 1, 0);
                        if (eventDate < today || eventDate > monthEnd) return false;
                    }
                }

                return true;
            });

            displayEvents();
        }

        // Perform search
        function performSearch() {
            applyFilters();
        }

        // Sort events
        function sortEvents(sortBy) {
            if (sortBy === 'date') {
                filteredEvents.sort((a, b) => new Date(a.startDate) - new Date(b.startDate));
            } else if (sortBy === 'popular') {
                filteredEvents.sort((a, b) => b.likes?.length - a.likes?.length);
            } else if (sortBy === 'price-low') {
                filteredEvents.sort((a, b) => a.price - b.price);
            } else if (sortBy === 'price-high') {
                filteredEvents.sort((a, b) => b.price - a.price);
            }
            currentPage = 1;
            displayEvents();
        }

        // Clear all filters
        function clearAllFilters() {
            document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
            document.querySelectorAll('input[type="radio"]').forEach(rb => rb.checked = false);
            document.getElementById('searchInput').value = '';
            document.getElementById('locationInput').value = '';
            applyFilters();
        }

        // Go to page
        function goToPage(pageNum) {
            currentPage = pageNum;
            displayEvents();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Go to event details
        function goToEventDetails(eventId) {
            window.location.href = `/Events/Details/${eventId}`;
        }

        // Show/hide loading spinner
        function showLoading(show) {
            document.getElementById('loadingContainer').style.display = show ? 'flex' : 'none';
        }

        // Allow search on Enter key
        document.getElementById('searchInput')?.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                performSearch();
            }
        });
    </script>
</body>
</html>